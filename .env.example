# Property owner outreach
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email@example.com
FROM_NAME=Your Public Adjusting Firm

# Firm details (used in outreach templates)
FIRM_NAME=Your Public Adjusting Firm
ADJUSTER_NAME=Your Name
ADJUSTER_LICENSE=W123456
ADJUSTER_PHONE=(555) 555-5555
ADJUSTER_EMAIL=adjuster@yourfirm.com
FIRM_WEBSITE=https://yourfirm.com

# FEMA API (no key required for open data)
FEMA_API_BASE=https://www.fema.gov/api/open/v2

# NewsAPI key (get free key at https://newsapi.org)
NEWS_API_KEY=your_newsapi_key_here
NEWS_API_BASE=https://newsapi.org/v2

# Florida public records / property appraiser
# Each county exposes its own portal; leave blank to skip lookup
PROPERTY_APPRAISER_API_KEY=

# HOA marketing
HOA_OUTREACH_DELAY_DAYS=30
